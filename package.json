{
  "name": "s8n",
  "version": "0.8.0",
  "packageManager": "bun@1.3.4",
  "module": "src/cli/index.ts",
  "type": "module",
  "private": true,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "s8n": "src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build --compile --outfile dist/s8n src/cli/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:public": "bun run scripts/check-public-content.ts",
    "check:english": "bun run scripts/check-english.ts",
    "check": "bun run check:public && bun run check:english && bun run lint && bun run typecheck && bun run test",
    "quality:emulator": "bun run scripts/emulator-quality-gate.ts",
    "quality:services": "bun run scripts/service-emulator-quality-gate.ts",
    "quality:real-services": "bun run scripts/real-service-workflow-simulation.ts --summary",
    "quality:rehearsal": "bun run scripts/rehearsal-quality-gate.ts",
    "quality:workflow-tests": "bun run scripts/workflow-tests-quality-gate.ts",
    "quality:features": "bun run scripts/feedback-features-quality-gate.ts",
    "quality:community": "bun run scripts/community-quality-gate.ts",
    "quality:corpus": "bun run scripts/community-corpus-quality-gate.ts",
    "audit:corpus": "bun run scripts/workflow-corpus-audit.ts",
    "quality": "bun run check && bun run build && bun run quality:rehearsal && bun run quality:workflow-tests && bun run quality:features && bun run quality:emulator && bun run quality:services && bun run quality:real-services && bun run quality:corpus"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "latest",
    "emulate": "^0.9.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@types/luxon": "^3.7.2",
    "commander": "^15.0.0",
    "luxon": "^3.7.2",
    "zod": "^4.4.3"
  }
}
