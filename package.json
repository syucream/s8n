{
  "name": "s8n",
  "version": "0.3.0",
  "module": "src/cli/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "s8n": "src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build --compile --outfile dist/s8n src/cli/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:english": "bun run scripts/check-english.ts",
    "check": "bun run check:english && bun run lint && bun run typecheck && bun run test",
    "quality:emulator": "bun run scripts/emulator-quality-gate.ts",
    "quality:community": "bun run scripts/community-quality-gate.ts",
    "quality:corpus": "bun run scripts/community-corpus-quality-gate.ts",
    "quality": "bun run check && bun run build && bun run quality:emulator && bun run quality:corpus"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "latest",
    "emulate": "^0.9.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@types/luxon": "^3.7.2",
    "commander": "^15.0.0",
    "luxon": "^3.7.2",
    "zod": "^4.4.3"
  }
}
